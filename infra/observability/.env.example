# R2 S3 credentials for the corates-loki bucket.
# Dashboard: R2 > Manage R2 API Tokens > Create API Token
#   - Permissions: Object Read & Write, scoped to the corates-loki bucket only
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# htpasswd entry (user:hash) enforced by Traefik on loki.jacobmaynard.dev.
# Generate: openssl passwd -apr1 "<password>" then format as user:<hash>
# IMPORTANT: escape each $ in the hash as $$ (compose interpolates env values)
LOKI_BASIC_AUTH=

# Grafana admin login (user: admin) at grafana.jacobmaynard.dev
GRAFANA_ADMIN_PASSWORD=

# Read-only ClickHouse user Grafana uses to query Plausible. Defined in the home-lab repo
# (services/plausible/clickhouse/grafana-reader.xml); must match that stack's .env
CLICKHOUSE_GRAFANA_PASSWORD=

# Grafana alert email over Postmark SMTP; same value as packages/web/.env.production
POSTMARK_SERVER_TOKEN=

# Alert recipient (comma-separated for several)
ALERT_EMAIL_TO=
