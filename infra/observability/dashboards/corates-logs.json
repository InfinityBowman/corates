{
  "title": "CoRATES Production",
  "uid": "corates-logs",
  "description": "Production Workers logs exported via OTLP to Loki. Panels key off Loki's detected_level and the OTLP structured metadata Cloudflare attaches (handler type, entrypoint, url_path, script version, trace/ray id) rather than the JSON logger alone - only a small fraction of lines are logger JSON. Staging is excluded on purpose. Export latency from Cloudflare is roughly 2-4 minutes.",
  "tags": ["corates", "loki", "production"],
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "options": [],
        "refresh": 1,
        "regex": "",
        "hide": 0
      },
      {
        "name": "service",
        "label": "Service",
        "description": "Production services only; new prod workers appear here once they log.",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "query": "label_values({deployment_environment_name=\"production\"}, service_name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "sort": 1,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": []
      },
      {
        "name": "level",
        "label": "Level",
        "description": "Loki's detected_level, which covers every line - not just logger JSON.",
        "type": "custom",
        "query": "debug,info,log,warn,warning,error,fatal",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": [
          { "selected": true, "text": "All", "value": "$__all" },
          { "selected": false, "text": "debug", "value": "debug" },
          { "selected": false, "text": "info", "value": "info" },
          { "selected": false, "text": "log", "value": "log" },
          { "selected": false, "text": "warn", "value": "warn" },
          { "selected": false, "text": "warning", "value": "warning" },
          { "selected": false, "text": "error", "value": "error" },
          { "selected": false, "text": "fatal", "value": "fatal" }
        ]
      },
      {
        "name": "search",
        "label": "Search",
        "description": "Regex line filter applied to the raw log line.",
        "type": "textbox",
        "query": "",
        "current": { "selected": false, "text": "", "value": "" },
        "options": []
      },
      {
        "name": "trace",
        "label": "Trace / Ray ID",
        "description": "Paste a trace_id or cf-ray to pull every line from one invocation, including library output and the invocation summary.",
        "type": "textbox",
        "query": "",
        "current": { "selected": false, "text": "", "value": "" },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Errors",
      "description": "Every line Loki classified as error or fatal, including uncaught exceptions and library console output that is not logger JSON.",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=~\"$service\", deployment_environment_name=\"production\"} | detected_level=~`error|fatal` [$__auto]))",
          "legendFormat": "errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": { "mode": "fixed", "fixedColor": "#F2495C" },
          "custom": { "fillOpacity": 25, "lineWidth": 1 }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Warnings",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=~\"$service\", deployment_environment_name=\"production\"} | detected_level=~`warn|warning` [$__auto]))",
          "legendFormat": "warnings"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": { "mode": "fixed", "fixedColor": "#FF9830" },
          "custom": { "fillOpacity": 25, "lineWidth": 1 }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Log volume",
      "description": "Total lines ingested over the selected range. The sparkline is the shape that matters, not the number.",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=~\"$service\", deployment_environment_name=\"production\"} [$__auto]))",
          "legendFormat": "lines"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": { "mode": "fixed", "fixedColor": "#5794F2" },
          "custom": { "fillOpacity": 25, "lineWidth": 1 }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Last log received",
      "description": "Cloudflare batches the OTLP export, so 2-4 minutes behind is normal and does not mean production is down. Much older than that means the export or Loki is broken.",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 15, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "max(max_over_time({service_name=~\"$service\", deployment_environment_name=\"production\"} | unwrap observed_timestamp [30m])) / 1000000",
          "queryType": "instant",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "noValue": "no logs",
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Deploy versions in range",
      "description": "Distinct cloudflare_script_version_id values seen. More than one means a deploy landed inside this window - check whether an error spike lines up with it.",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (cloudflare_script_version_id) (count_over_time({service_name=~\"$service\", deployment_environment_name=\"production\"} | cloudflare_script_version_id!=`` [$__range])))",
          "queryType": "instant",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": { "mode": "fixed", "fixedColor": "#B877D9" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Log volume by level",
      "description": "Uses detected_level, so this covers all ingested lines rather than only the JSON logger subset.",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 14, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (detected_level) (count_over_time({service_name=~\"$service\", deployment_environment_name=\"production\"} | detected_level=~`$level` [$__auto]))",
          "legendFormat": "{{detected_level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 85,
            "lineWidth": 0,
            "stacking": { "mode": "normal", "group": "A" },
            "gradientMode": "none",
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#F2495C" } }]
          },
          {
            "matcher": { "id": "byName", "options": "fatal" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#C4162A" } }]
          },
          {
            "matcher": { "id": "byName", "options": "warn" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF9830" } }]
          },
          {
            "matcher": { "id": "byName", "options": "info" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#5794F2" } }]
          },
          {
            "matcher": { "id": "byName", "options": "log" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3274D9" } }]
          },
          {
            "matcher": { "id": "byName", "options": "debug" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#8E8E8E" } }]
          }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Traffic by handler type",
      "description": "Roughly a third of production volume is hibernatableWebSocket on Durable Objects (the Yjs sync path). A drop to zero here with fetch still healthy points at the sync layer, not the site.",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cloudflare_handler_type) (count_over_time({service_name=~\"$service\", deployment_environment_name=\"production\"} | cloudflare_handler_type!=`` [$__auto]))",
          "legendFormat": "{{cloudflare_handler_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top error signatures",
      "description": "Groups errors by a normalized signature: the JSON logger's message field when present, otherwise the raw line with any leading ISO timestamp stripped, truncated to 90 chars. This collapses repeated stack traces that the raw message field cannot see.",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, sum by (sig, service_name) (count_over_time({service_name=~\"$service\", deployment_environment_name=\"production\"} | detected_level=~`error|fatal` | json | drop __error__, __error_details__ | line_format `{{ if .message }}{{ .message }}{{ else }}{{ __line__ }}{{ end }}` | regexp `^(?:\\S+Z\\s+)?(?P<sig>.{0,90})` [$__range])))",
          "queryType": "instant",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": { "sig": "Error", "service_name": "Service", "Value": "Count" },
            "indexByName": { "sig": 0, "service_name": 1, "Value": 2 }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": false },
          "noValue": "no errors in range"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Count" },
            "properties": [
              { "id": "custom.width", "value": 90 },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#F2495C" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Service" },
            "properties": [{ "id": "custom.width", "value": 240 }]
          }
        ]
      },
      "options": { "sortBy": [{ "displayName": "Count", "desc": true }], "showHeader": true }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Top request paths",
      "description": "From the Cloudflare invocation logs. Cloudflare redacts dynamic path segments as REDACTED.",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 21 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, sum by (url_path, http_request_method) (count_over_time({service_name=~\"$service\", deployment_environment_name=\"production\"} | url_path!=`` [$__range])))",
          "queryType": "instant",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "http_request_method": "Method",
              "url_path": "Path",
              "Value": "Count"
            },
            "indexByName": { "http_request_method": 0, "url_path": 1, "Value": 2 }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": false },
          "noValue": "no requests in range"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Method" },
            "properties": [{ "id": "custom.width", "value": 90 }]
          },
          {
            "matcher": { "id": "byName", "options": "Count" },
            "properties": [{ "id": "custom.width", "value": 90 }]
          }
        ]
      },
      "options": { "sortBy": [{ "displayName": "Count", "desc": true }], "showHeader": true }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Durable Object activity by entrypoint",
      "description": "UserSession and WorkspaceDO invocations. Useful when the sync layer misbehaves - a flatline or a spike here is the first signal.",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 21 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cloudflare_entrypoint) (count_over_time({service_name=~\"$service\", deployment_environment_name=\"production\"} | cloudflare_entrypoint!=`` [$__auto]))",
          "legendFormat": "{{cloudflare_entrypoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Recent errors",
      "description": "Raw error lines at full fidelity. Expand one and copy its trace_id or cloudflare_ray_id into the Trace / Ray ID filter to see the whole invocation in the panel below.",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 30 },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"$service\", deployment_environment_name=\"production\"} | detected_level=~`error|fatal`",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Logs",
      "description": "All production lines, filtered by the variables above. No | json stage, so library output and Cloudflare invocation logs are included rather than silently dropped.",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 40 },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"$service\", deployment_environment_name=\"production\"} |~ `$search` | detected_level=~`$level` | trace_id=~`$trace.*` or cloudflare_ray_id=~`$trace.*`",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
