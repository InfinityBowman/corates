{
  "title": "CoRATES Billing",
  "uid": "corates-billing",
  "description": "Checkout funnels, subscription lifecycle, and Stripe webhook ingress. Spans two streams: billing.* events from corates-workers-prod and stripe.* events from corates-stripe-purchases-prod. Production only; OTLP export latency is roughly 2-4 minutes.",
  "tags": ["corates", "loki", "production", "billing"],
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "options": [],
        "refresh": 1,
        "regex": "",
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Health",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Plan unresolved",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"corates-workers-prod\", deployment_environment_name=\"production\"} | json | message=\"billing.subscription_plan_unresolved\" [$__auto]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 1
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#F2495C"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "description": "billing.subscription_plan_unresolved - a Stripe priceId did not map to a plan, so the subscription row was written with the UNRESOLVED_PLAN sentinel. Check the priceId column below; it means the catalog and Stripe have drifted."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Subscription writes skipped",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"corates-workers-prod\", deployment_environment_name=\"production\"} | json | message=~`billing\\.(subscription_sync_skipped|sync_after_checkout_skipped)` [$__auto]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 1
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#FF9830"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "description": "A sync ran and deliberately wrote nothing: no orgId on the Stripe subscription, or no Stripe customer on the user. The DB is stale until a webhook arrives with better metadata."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Checkout failures",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"corates-workers-prod\", deployment_environment_name=\"production\"} | json | message=\"billing.checkout_failed\" [$__auto]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 1
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#F2495C"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "description": "billing.checkout_failed - the single-project checkout could not be built at all (missing Stripe key, unconfigured price, no customer, session returned without a URL). These are configuration faults, not user errors."
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Webhooks rejected",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"corates-stripe-purchases-prod\", deployment_environment_name=\"production\"} | json | message=\"stripe.webhook_rejected\" [$__auto]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 1
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#F2495C"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "description": "stripe.webhook_rejected on corates-stripe-purchases-prod - unreadable body, missing signature, or a signature that failed verification. Stripe retries, so a sustained rate means events are being dropped."
    },
    {
      "id": 6,
      "type": "row",
      "title": "Checkout funnels",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Subscription checkouts started",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"corates-workers-prod\", deployment_environment_name=\"production\"} | json | message=\"billing.checkout_initiated\" [$__auto]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 1
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "description": "billing.checkout_initiated - handed off to Better Auth's upgradeSubscription."
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Subscriptions completed",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"corates-workers-prod\", deployment_environment_name=\"production\"} | json | message=\"billing.subscription_completed\" [$__auto]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 1
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#73BF69"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "description": "billing.subscription_completed - fired from the Better Auth Stripe hook once Stripe confirms."
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Subscription conversion",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"corates-workers-prod\", deployment_environment_name=\"production\"} | json | message=\"billing.subscription_completed\" [$__range]))\n  /\nsum(count_over_time({service_name=\"corates-workers-prod\", deployment_environment_name=\"production\"} | json | message=\"billing.checkout_initiated\" [$__range]))",
          "queryType": "instant",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "0",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 1
          },
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F2495C",
                "value": null
              },
              {
                "color": "#FF9830",
                "value": 0.2
              },
              {
                "color": "#73BF69",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "description": "Completions divided by initiations over the selected range. Completion arrives by webhook minutes after initiation, so short ranges and range edges understate it. Above 1 means a subscription completed whose checkout started before the range."
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Single-project checkouts started",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"corates-workers-prod\", deployment_environment_name=\"production\"} | json | message=\"billing.single_project_checkout_initiated\" [$__auto]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 1
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "description": "billing.single_project_checkout_initiated - the one-off purchase path, separate from subscriptions."
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Single-project sessions created",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"corates-workers-prod\", deployment_environment_name=\"production\"} | json | message=\"billing.checkout_created\" [$__auto]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 1
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#73BF69"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "description": "billing.checkout_created - a Stripe Checkout Session with a URL came back. Only the single-project path emits this; subscription upgrades go straight through Better Auth and never do."
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Trials started",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"corates-workers-prod\", deployment_environment_name=\"production\"} | json | message=\"billing.trial_started\" [$__auto]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 1
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#B877D9"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "description": "billing.trial_started - a trial grant was written."
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Funnel events over time",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (message) (count_over_time({service_name=\"corates-workers-prod\", deployment_environment_name=\"production\"} | json | message=~`billing\\.(checkout_initiated|single_project_checkout_initiated|checkout_created|subscription_completed|trial_started)` [$__auto]))",
          "legendFormat": "{{message}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 85,
            "lineWidth": 0,
            "gradientMode": "none",
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Both checkout paths and trial grants on one axis. Gaps between an initiation series and its completion series are the drop-off."
    },
    {
      "id": 14,
      "type": "table",
      "title": "Why billing said no",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, sum by (message, reason) (count_over_time({service_name=\"corates-workers-prod\", deployment_environment_name=\"production\"} | json | message=~`billing\\.(checkout_rejected|trial_rejected|checkout_failed)` | reason!=`` [$__range])))",
          "queryType": "instant",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "message": "Event",
              "reason": "Reason",
              "Value": "Count"
            },
            "indexByName": {
              "message": 0,
              "reason": 1,
              "Value": 2
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          },
          "noValue": "nothing in range"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Count"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Count",
            "desc": true
          }
        ],
        "showHeader": true
      },
      "description": "Rejections are expected user-facing outcomes (invalid_tier, already_on_plan, downgrade_exceeds_quotas, trial_already_exists). checkout_failed rows are not - those are configuration faults."
    },
    {
      "id": 15,
      "type": "row",
      "title": "Subscription lifecycle",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Subscription transitions",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (message) (count_over_time({service_name=\"corates-workers-prod\", deployment_environment_name=\"production\"} | json | message=~`billing\\.subscription_(completed|updated|canceled|canceled_by_sync|synced)` [$__auto]))",
          "legendFormat": "{{message}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 85,
            "lineWidth": 0,
            "gradientMode": "none",
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "canceled_by_sync is the force-cancel write that syncStripeSubscription performs when Stripe reports no subscription for a customer. It is a reconciliation, not a user action - a spike means webhooks were missed."
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Net subscription change",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 10,
        "x": 14,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"corates-workers-prod\", deployment_environment_name=\"production\"} | json | message=\"billing.subscription_completed\" [$__range]))\n  -\nsum(count_over_time({service_name=\"corates-workers-prod\", deployment_environment_name=\"production\"} | json | message=~`billing\\.subscription_(canceled|canceled_by_sync)` [$__range]))",
          "queryType": "instant",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 1
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F2495C",
                "value": null
              },
              {
                "color": "#FF9830",
                "value": 0
              },
              {
                "color": "#73BF69",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "description": "Completions minus cancellations over the range. Counts transitions, not active subscribers."
    },
    {
      "id": 18,
      "type": "table",
      "title": "Transitions by plan and status",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 10,
        "x": 14,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(12, sum by (plan, status) (count_over_time({service_name=\"corates-workers-prod\", deployment_environment_name=\"production\"} | json | message=~`billing\\.subscription_(completed|updated|canceled)` | plan!=`` [$__range])))",
          "queryType": "instant",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "plan": "Plan",
              "status": "Stripe status",
              "Value": "Count"
            },
            "indexByName": {
              "plan": 0,
              "status": 1,
              "Value": 2
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          },
          "noValue": "nothing in range"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Count"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Count",
            "desc": true
          }
        ],
        "showHeader": true
      }
    },
    {
      "id": 19,
      "type": "table",
      "title": "Unresolved price ids",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 27
